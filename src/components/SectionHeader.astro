---
interface Props {
  /** Kept for callers; no longer rendered (the numbered eyebrow only repeated the heading). */
  num?: string;
  title: string;
  id: string;
}
const { title, id } = Astro.props;
---
<header class="section-header">
  <h2 id={id}>{title}</h2>
  <div class="rule" aria-hidden="true"></div>
</header>
